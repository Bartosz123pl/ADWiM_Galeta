<Window x:Class="Aplikacja_Desktopowa0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aplikacja_Desktopowa0"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="500">
    <Grid ShowGridLines="True" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition Width="250"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>
        <Label Content="a:" Grid.Column="0" Grid.Row="2" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="b:" Grid.Column="0" Grid.Row="3" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="c:" Grid.Column="0" Grid.Row="4" Height="100" Width="200" FontSize="20"></Label>
        <TextBox Grid.Column="1" Grid.Row="2" Name="input1"></TextBox>
        <TextBox Grid.Column="1" Grid.Row="3" Name="input2"></TextBox>
        <TextBox Grid.Column="1" Grid.Row="4" Name="input3"></TextBox>
        <Label Content="Kalkulator funkcji kwadratowej" Grid.Column="0" Grid.Row="0" FontSize="30" Height="50" Width="450" Grid.ColumnSpan="2"></Label>
        <Button Content="Oblicz" Name="Button1" Grid.Column="0" Grid.Row="1" Height="50" Width="100" Click="Oblicz"></Button>
        <Label Content="" Grid.Column="1" Grid.Row="1" Height="100" Width="200" FontSize="20" Name="Wynik"></Label>
    </Grid>
</Window>
