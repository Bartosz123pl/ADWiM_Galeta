<Window x:Class="Aplikacja_Desktopowa2.Views.AuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dane autora"
        Height="250" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Imię"/>
            <TextBox x:Name="FirstNameBox" Margin="0,5,0,15"/>

            <TextBlock Text="Nazwisko"/>
            <TextBox x:Name="LastNameBox" Margin="0,5,0,15"/>
        </StackPanel>

        <Button Grid.Row="1"
                Content="Zapisz"
                Width="100"
                Height="35"
                HorizontalAlignment="Right"
                Click="Save_Click"/>
    </Grid>
</Window>
