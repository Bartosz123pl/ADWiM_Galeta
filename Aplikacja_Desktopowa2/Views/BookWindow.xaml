<Window x:Class="Aplikacja_Desktopowa2.Views.BookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dane książki"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Tytuł"/>
            <TextBox x:Name="TitleBox" Margin="0,5,0,12"/>

            <TextBlock Text="ISBN"/>
            <TextBox x:Name="ISBNBox" Margin="0,5,0,12"/>

            <TextBlock Text="Cena"/>
            <TextBox x:Name="PriceBox" Margin="0,5,0,12"/>

            <TextBlock Text="Ilość w magazynie"/>
            <TextBox x:Name="QuantityBox" Margin="0,5,0,12"/>

            <TextBlock Text="Autor"/>
            <ComboBox x:Name="AuthorCombo"
                      DisplayMemberPath="LastName"
                      Margin="0,5,0,12"/>

            <TextBlock Text="Wydawnictwo"/>
            <ComboBox x:Name="PublisherCombo"
                      DisplayMemberPath="Name"
                      Margin="0,5,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Zapisz"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="Save_Click"/>

            <Button Content="Anuluj"
                    Width="100"
                    Height="35"
                    Margin="5"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
