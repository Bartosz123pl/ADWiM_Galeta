<Window x:Class="Aplikacja_Desktopowa2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System magazynowy księgarni"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="SYSTEM MAGAZYNOWY KSIĘGARNI"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">

            <!-- KSIĄŻKI -->
            <TabItem Header="Książki">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <TextBox x:Name="SearchBox"
                                 Width="300"
                                 Height="30"
                                 FontSize="14"
                                 TextChanged="SearchBox_TextChanged"/>
                    </DockPanel>

                    <DataGrid x:Name="BooksGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="50"/>

                            <DataGridTextColumn Header="Tytuł"
                                                Binding="{Binding Title}"
                                                Width="*"/>

                            <DataGridTextColumn Header="ISBN"
                                                Binding="{Binding ISBN}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Autor"
                                                Binding="{Binding Author.LastName}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Wydawnictwo"
                                                Binding="{Binding Publisher.Name}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Cena"
                                                Binding="{Binding Price, StringFormat={}{0:F2} zł}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Ilość"
                                                Binding="{Binding Quantity}"
                                                Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">

                        <Button Content="Dodaj"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="AddBook_Click"/>

                        <Button Content="Edytuj"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="EditBook_Click"/>

                        <Button Content="Usuń"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="DeleteBook_Click"/>

                        <Button Content="Odśwież"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- AUTORZY -->
            <TabItem Header="Autorzy">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="AuthorsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Imię"
                                                Binding="{Binding FirstName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Nazwisko"
                                                Binding="{Binding LastName}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">

                        <Button Content="Dodaj"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="AddAuthor_Click"/>

                        <Button Content="Edytuj"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="EditAuthor_Click"/>

                        <Button Content="Usuń"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="DeleteAuthor_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- WYDAWNICTWA -->
            <TabItem Header="Wydawnictwa">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="PublishersGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Nazwa"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Adres"
                                                Binding="{Binding Address}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">

                        <Button Content="Dodaj"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="AddPublisher_Click"/>

                        <Button Content="Edytuj"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="EditPublisher_Click"/>

                        <Button Content="Usuń"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Click="DeletePublisher_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
