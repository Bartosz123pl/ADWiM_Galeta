<Window x:Class="Aplikacja_Desktopowa1.Zobacz"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aplikacja_Desktopowa1"
        mc:Ignorable="d"
        Title="Zobacz" Height="1000" Width="500">
    <Grid ShowGridLines="True" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition Width="250"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>
        <Label Content="Imie:" Grid.Column="0" Grid.Row="0" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="Nazwisko:" Grid.Column="0" Grid.Row="1" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="Płeć:" Grid.Column="0" Grid.Row="2" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="PESEL:" Grid.Column="0" Grid.Row="3" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="Menadżer:" Grid.Column="0" Grid.Row="4" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="" Grid.Column="1" Grid.Row="0" Height="100" Width="200" FontSize="20" Name="Imie"></Label>
        <Label Content="" Grid.Column="1" Grid.Row="1" Height="100" Width="200" FontSize="20" Name="Nazwisko"></Label>
        <Label Content="" Grid.Column="1" Grid.Row="2" Height="100" Width="200" FontSize="20" Name="Plec"></Label>
        <Label Content="" Grid.Column="1" Grid.Row="3" Height="100" Width="200" FontSize="20" Name="PESEL"></Label>
        <Label Content="" Grid.Column="1" Grid.Row="4" Height="100" Width="200" FontSize="20" Name="Menadzer"></Label>
    </Grid>
</Window>