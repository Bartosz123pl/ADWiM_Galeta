<Window x:Class="Aplikacja_Desktopowa1.Dodaj"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aplikacja_Desktopowa1"
        mc:Ignorable="d"
        Title="Zobacz" Height="1200" Width="500">
    <Grid ShowGridLines="True" Margin="20">
        <!-- Definiowanie 3 kolumn o równej szerokości (*) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition Width="250"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Definiowanie 3 wierszy o równej wysokości (*) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>
        <Label Content="Imie:" Grid.Column="0" Grid.Row="0" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="Nazwisko:" Grid.Column="0" Grid.Row="1" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="Wypłata:" Grid.Column="0" Grid.Row="2" Height="100" Width="200" FontSize="20"></Label>
        <Label Content="PESEL:" Grid.Column="0" Grid.Row="3" Height="100" Width="200" FontSize="20"></Label>
        <CheckBox Name="menadzer" Grid.Column="0" Grid.Row="4" Height="100" Width="200"></CheckBox>
        <Label Content="Czy menadżer?" Grid.Column="1" Grid.Row="4" Height="100" Width="200" FontSize="20"></Label>
        <Button Content="Dodaj" Name="Button3" Grid.Column="0" Grid.Row="5" Height="50" Width="100" Click="Zapisz"></Button>
        <TextBox Grid.Column="1" Grid.Row="0" Name="input1"></TextBox>
        <TextBox Grid.Column="1" Grid.Row="1" Name="input2"></TextBox>
        <TextBox Grid.Column="1" Grid.Row="2" Name="input3"></TextBox>
        <TextBox Grid.Column="1" Grid.Row="3" Name="input4"></TextBox>

    </Grid>
</Window>