<Window x:Class="Aplikacja_Desktopowa1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aplikacja_Desktopowa1"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="500">
    <Grid ShowGridLines="True" Margin="20">
        <!-- Definiowanie 3 kolumn o równej szerokości (*) -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition Width="250"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Definiowanie 3 wierszy o równej wysokości (*) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="333" />
            <RowDefinition Height="333" />
            <RowDefinition Height="333" />
        </Grid.RowDefinitions>
        <Label Content="Dodaj pracownika" Grid.Column="0" Grid.Row="0" FontSize="30" Height="50" Width="250" Grid.ColumnSpan="2"></Label>
        <ListBox Name="Listbox1" Grid.Column="0" Grid.Row="1" Height="333" Width="250" DisplayMemberPath="PelneImie"/>
        <Button Content="Usuń pracownika" Name="Button1" Grid.Column="0" Grid.Row="2" Height="50" Width="100"></Button>
        <Button Content="Zobacz pracownika" Name="Button2" Grid.Column="1" Grid.Row="2" Height="50" Width="100"></Button>

    </Grid>

</Window>